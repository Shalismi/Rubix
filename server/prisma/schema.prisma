generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int       @id @default(autoincrement())
  username           String    @unique
  passwordHash       String    @map("password_hash")
  tagPriorityEnabled Boolean   @default(true) @map("tag_priority_enabled")
  sessions           Session[]
  tasks              Task[]
  tags               Tag[]
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  /// SHA-256 fingerprint of the random token stored in the browser cookie.
  id        String   @id
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Task {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  title       String
  description String?
  /// Date-only value in YYYY-MM-DD format, matching the client date input.
  dueDate     String    @map("due_date")
  completed   Boolean   @default(false)
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskTags    TaskTag[]

  @@index([userId])
  @@index([deletedAt])
  @@map("tasks")
}

model Tag {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  name           String
  normalizedName String    @map("normalized_name")
  color          String
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskTags       TaskTag[]

  @@unique([userId, normalizedName])
  @@index([userId])
  @@index([userId, sortOrder])
  @@map("tags")
}

model TaskTag {
  taskId Int  @map("task_id")
  tagId  Int  @map("tag_id")
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
  @@map("task_tags")
}
